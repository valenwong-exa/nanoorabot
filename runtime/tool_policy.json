      "regexFlags": "i",
      "category": "oracle",
      "severity": "high",
      "mode": "warn",
      "scope": "SQL",
      "note": "避免整表更新"
    },
    {
      "command": "\\balter\\s+system\\s+flush\\s+shared_pool\\b",
      "matchType": "regex",
      "regexFlags": "i",
      "category": "oracle",
      "severity": "high",
      "mode": "warn",
      "scope": "SQL",
      "note": "刷新 Shared Pool 前需要人工确认"
    },
    {
