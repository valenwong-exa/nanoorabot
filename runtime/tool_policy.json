      "scope": "SQL",
      "note": "高风险数据清空操作"
    },
    {
      "command": "drop table",
      "matchType": "literal",
      "regexFlags": "",
      "category": "oracle",
      "severity": "critical",
      "mode": "block",
      "scope": "SQL",
      "note": "直接删除表结构与数据"
    },
    {
      "command": "delete from",
      "matchType": "literal",
      "regexFlags": "",
      "category": "oracle",
      "severity": "high",
      "mode": "warn",
      "scope": "SQL",
      "note": "大批量删除需要人工确认"
    },
    {
      "command": "\\bupdate\\b[\\s\\S]*?\\bset\\b(?:(?!\\bwhere\\b)[\\s\\S])*$",
